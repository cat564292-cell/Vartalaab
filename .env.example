# Google Cloud Translation API (optional, broad language support + auto-detect).
# Enable "Cloud Translation API" in Google Cloud Console → Credentials.
VITE_GOOGLE_TRANSLATE_API_KEY=

# DeepL API (optional, often excellent for many language pairs).
# Free: https://www.deepl.com/pro-api — use api-free host by default.
VITE_DEEPL_API_KEY=
# Pro subscribers can set: VITE_DEEPL_API_URL=https://api.deepl.com/v2/translate
# VITE_DEEPL_API_URL=
